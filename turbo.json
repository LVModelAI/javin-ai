{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "FIRECRAWL_API_KEY",
        "FIRECRAWL_API_ENDPOINT",
        "POSTGRES_URL",
        "OPENAI_API_KEY",
        "DEEPSEEK_API_KEY",
        "GROQ_API_KEY",
        "XAI_API_KEY",
        "PERPLEXITY_API_KEY",
        "AUTH_SECRET",
        "AUTH_GOOGLE_ID",
        "AUTH_GOOGLE_SECRET",
        "POSTGRES_URL_PROD",
        "POSTGRES_URL_DEV",
        "NODE_ENV",
        "NEXT_PUBLIC_THIRDWEB_CLIENT_ID",
        "THIRDWEB_SECRET_KEY",
        "NEXT_PUBLIC_THIRDWEB_AUTH_DOMAIN",
        "AUTH_PRIVATE_KEY",
        "NEXT_PUBLIC_WEB3AUTH_CLIENT_ID",
        "GUEST_USER_MESSAGE_LIMIT",
        "FREE_USER_MESSAGE_LIMIT",
        "PRO_USER_MESSAGE_LIMIT",
        "BLOCKSCOUT_API_KEY",
        "BIRDEYE_API_KEY",
        "ZERION_DEV_API_KEY",
        "TAVILY_API_KEY",
        "ETHERSCAN_API_KEY",
        "NOVES_API_KEY",
        "EMAIL_USER",
        "EMAIL_PASS",
        "SENTIENT_EXTERNAL_APIKEY",
        "EXA_API_KEY"
      ]
    },
    "lint": {},
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    }
  }
}
