{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "FIRECRAWL_API_KEY",
        "FIRECRAWL_API_ENDPOINT",
        "POSTGRES_URL",
        "SENTRY_AUTH_TOKEN",
        "UPSTASH_REDIS_REST_URL",
        "UPSTASH_REDIS_REST_TOKEN",
        "POSTGRES_JAVIN_API_URL",
        "NOVES_API_KEY",
        "SENTIENT_EXTERNAL_APIKEY",
        "SOLANA_QUICKNODE_RPC_ENDPOINT",
        "FIREWORKS_API_KEY",
        "PRIVATE_KEY",
        "API_ENDPOINT",
        "CONTRACT_ACCOUNT",
        "ACTOR",
        "EMAIL_REFRESH_TOKEN",
        "EMAIL_REDIRECT_URI",
        "EMAIL_USER",
        "GROQ_API_KEY",
        "PINECONE_API_KEY",
        "PINECONE_INDEX_NAME",
        "PINECONE_INDEX_HOST",
        "GOOGLE_GENERATIVE_AI_API_KEY"
      ]
    },
    "lint": {},
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    }
  }
}
