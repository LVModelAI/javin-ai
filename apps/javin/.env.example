# Database
POSTGRES_URL=postgresql://user:password@localhost:5432/postgres
POSTGRES_JAVIN_API_URL=postgresql://user:password@localhost:5432/javin_api

# NextAuth Configuration
AUTH_SECRET=your-auth-secret-here-generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# Google OAuth (for authentication and email)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Email Configuration
EMAIL_USER=your-email@gmail.com
EMAIL_REFRESH_TOKEN=your-email-refresh-token
EMAIL_REDIRECT_URI=your-email-redirect-uri

# Application URLs
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Message Limits
FREE_USER_MESSAGE_LIMIT=20
PRO_USER_MESSAGE_LIMIT=1000

# Cron Secret (for protected cron endpoints)
CRON_SECRET=your-cron-secret-here

# AI/ML API Keys
OPENAI_API_KEY=your-openai-api-key
DEEPSEEK_API_KEY=your-deepseek-api-key
GROQ_API_KEY=your-groq-api-key
FIREWORKS_API_KEY=your-fireworks-api-key
GOOGLE_GENERATIVE_AI_API_KEY=your-google-generative-ai-api-key

# Blockchain API Keys
ZERION_DEV_API_KEY=your-zerion-api-key
BIRDEYE_API_KEY=your-birdeye-api-key
ETHERSCAN_API_KEY=your-etherscan-api-key
BLOCKSCOUT_API_KEY=your-blockscout-api-key
BLOCKVISION_API_KEY=your-blockvision-api-key
NANSEN_API_KEY=your-nansen-api-key
NANSEN_BASE_URL=https://api.nansen.ai
TAVILY_API_KEY=your-tavily-api-key
NOVES_API_KEY=your-noves-api-key

# Blockchain RPC Endpoints
SOLANA_QUICKNODE_RPC_ENDPOINT=https://your-solana-rpc-endpoint

# Web Scraping
FIRECRAWL_API_KEY=your-firecrawl-api-key
FIRECRAWL_API_ENDPOINT=https://api.firecrawl.dev

# Vector Database (Pinecone)
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=your-pinecone-index-name
PINECONE_INDEX_HOST=your-pinecone-index-host

# Redis (Upstash)
UPSTASH_REDIS_REST_URL=your-upstash-redis-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token

# Wire Network (for verification)
PRIVATE_KEY=your-private-key
API_ENDPOINT=your-api-endpoint
CONTRACT_ACCOUNT=your-contract-account
ACTOR=your-actor

# Sentry (Error Tracking)
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# External APIs
SENTIENT_EXTERNAL_APIKEY=your-sentient-api-key

# Environment
NODE_ENV=development
